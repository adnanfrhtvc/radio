# Copy to .env for local `netlify dev`, and set the same variables in the
# Netlify UI (Site settings → Environment variables) for production.
# Never commit the real .env — only this example.

# Password for the /admin page.
ADMIN_PASSWORD=change-me

# YouTube Data API v3 key — needed to read durations and expand playlists.
# Get one at https://console.cloud.google.com (enable "YouTube Data API v3").
YOUTUBE_API_KEY=your-youtube-api-key
